{
  "multipart": [
    {"when": {"facing": "north"}, "apply": {"model": "jta:block/roundel/generated/nle/nle_roundel_pole"}},
    {"when": {"facing": "east"}, "apply": {"model": "jta:block/roundel/generated/nle/nle_roundel_pole", "y": 90, "uvlock": true}},
    {"when": {"facing": "south"}, "apply": {"model": "jta:block/roundel/generated/nle/nle_roundel_pole", "y": 180, "uvlock": true}},
    {"when": {"facing": "west"}, "apply": {"model": "jta:block/roundel/generated/nle/nle_roundel_pole", "y": 270, "uvlock": true}}
  ]
}