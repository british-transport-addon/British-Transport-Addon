{
    "multipart": [
        {
            "when": {
                "facing": "north"
            },
            "apply": {
                "model": "jta:block/display",
                "y": 180
            }
        },
        {
            "when": {
                "facing": "east"
            },
            "apply": {
                "model": "jta:block/display",
                "y": -90
            }
        },
        {
            "when": {
                "facing": "south"
            },
            "apply": {
                "model": "jta:block/display"
            }
        },
        {
            "when": {
                "facing": "west"
            },
            "apply": {
                "model": "jta:block/display",
                "y": 90
            }
        }
    ]
}